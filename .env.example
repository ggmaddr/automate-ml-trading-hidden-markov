ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_PAPER=true

# Gemini API authentication (Phase 10 research agent). Get a key at https://aistudio.google.com/apikey
# A Google One / Google AI Pro consumer subscription does NOT include API quota; use an AI Studio key.
GEMINI_API_KEY=

# Optional model override (default lives in config/settings.yaml -> research.model)
GEMINI_MODEL=

# Other research providers (set research.provider in config/settings.yaml, or RESEARCH_PROVIDER=...)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: Google Finance news via SerpApi (research.finance_news_provider: serpapi). Free plan: 250 searches/month.
SERPAPI_API_KEY=
